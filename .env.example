# Copy this file to .env and fill in your values
AIRNOW_API_KEY=your_airnow_api_key_here
FIRE_CACHE_TTL_SECONDS=21600
SNOW_CACHE_TTL_SECONDS=3600
WEATHER_CACHE_TTL_SECONDS=1800
AQI_CACHE_TTL_SECONDS=1800
# How many days back to include fire perimeters (0 = no limit)
FIRE_HISTORY_DAYS=365

# ── AI situation brief ────────────────────────────────────────────────────────
# Set OPENAI_API_KEY to generate the situation brief with OpenAI. If unset, the
# brief falls back to OLLAMA_BASE_URL/OLLAMA_MODEL and degrades quietly if down.
OPENAI_API_KEY=
# Cheap + capable default. Swap to gpt-4.1-mini for a bit more reasoning.
LLM_MODEL=gpt-4o-mini
# Optional self-hosted OpenAI-compatible fallback (leave blank to disable):
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=backcountry
POSTGRES_PASSWORD=backcountry
POSTGRES_DB=backcountry

# ── Database / storage ────────────────────────────────────────────────────────
# Async Postgres URL (use postgresql+asyncpg://). For local dev: docker compose up postgres.
DATABASE_URL=postgresql+asyncpg://backcountry:backcountry@localhost:5432/backcountry
# Where uploaded GPX files are stored on disk (per-user subdirs).
STORAGE_ROOT=./var/gpx
# Absolute host path to the trail GeoJSON file (mounted into the backend
# container at /data/trails.geojson). Required for trail search / matching.
TRAILS_FILE=/absolute/path/to/National_Forest_System_Trails.geojson

# ── Auth (Firebase) ───────────────────────────────────────────────────────────
# Host path to the service-account JSON downloaded from the Firebase console.
# docker-compose mounts this into the backend container.
FIREBASE_SERVICE_ACCOUNT_FILE=./data/firebase-service-account.json
# In-container path (you shouldn't need to change this).
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
# Comma-separated list of emails allowed to mint invite codes and manage admin
# endpoints. These accounts can also sign up without an invite code.
ADMIN_EMAILS=you@example.com

# ── Frontend build args (Vite) ────────────────────────────────────────────────
# Leave VITE_API_BASE empty for same-origin (nginx proxies /api to backend).
VITE_API_BASE=
# Mapbox public token — https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token
# Firebase web app config — Firebase console → Project settings → Your apps → Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Public exposure (Cloudflare Tunnel) ───────────────────────────────────────
# The single host port the Cloudflare Tunnel points to. Frontend nginx listens
# here and proxies /api/* to the backend over the docker network.
PUBLIC_PORT=8088
# Public origin allowed by CORS. With same-origin (frontend nginx proxying /api),
# CORS is bypassed entirely, but this stays as defense-in-depth.
FRONTEND_ORIGIN=https://your.tunnel.hostname

# ── Trail data pipeline ───────────────────────────────────────────────────────
# Path to the raw USFS GeoJSON. Defaults to data/trails.geojson if unset.
TRAILS_SOURCE=

# Where DEM tiles and OSM responses are cached between pipeline runs.
DEM_CACHE_DIR=.dem_cache
OSM_CACHE_DIR=.osm_cache

# Overpass mirrors, tried in order. The public instances rate-limit and time out,
# so the pipeline rotates across them rather than failing a tile on first error.
OVERPASS_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
OSM_TILE_STEP=1.0
OSM_PAUSE=2.0

# ── Conditions checks ─────────────────────────────────────────────────────────
# How far back a fire perimeter can have been updated and still count as current.
# The old default of 3650 reported decade-old burn scars as active fires.
FIRE_HISTORY_DAYS=60
ALERTS_CACHE_TTL_SECONDS=600

# ── AI situation brief (optional) ─────────────────────────────────────────────
# The brief only ever EXPLAINS the deterministic verdict; it never produces one.
# Leave both unset to disable it entirely — no third-party host is used by default.
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=llama3.1:8b
